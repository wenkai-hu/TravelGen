    "outline": [
      {
        "section": "引入（视觉吸引）",
        "title": "荷风入画，一眼西湖",
        "content": "0-6秒：固定机位静帧起幅，以画面前景大片荷花荷叶为视觉入口，蓝天白云作背景，字幕缓入“杭州·西湖”。整体调色清透大气，配空灵国风音乐，面向18-35岁年轻游客建立唯美初印象。",
        "duration_s": 6,
        "place_id": "place_317fc6749411d659",
        "visual_targets": [
          "前景大片荷花荷叶的景观层次",
          "蓝天与白色云朵"
        ],
        "evidence_asset_ids": [
          "ref_cfc6d53f5d130439"
        ]
      },
      {
        "section": "展开（核心景观）",
        "title": "拉远见湖山塔林",
        "content": "6-14秒：从前景荷花荷叶缓慢向后拉远，依次露出开阔湖面、湖岸茂密林木与垂柳，以及山林间多层古塔，稳住“山水塔林”整体空间结构。字幕点题“宋韵杭州”，不进入古塔、不环绕旋转。",
        "duration_s": 8,
        "place_id": "place_317fc6749411d659",
        "visual_targets": [
          "开阔湖泊的水面形态",
          "湖岸茂密林木（含垂柳）的沿岸布局",
          "山林间多层古塔的标志性造型与位置",
          "山水塔林的整体空间结构"
        ],
        "evidence_asset_ids": [
          "ref_cfc6d53f5d130439"
        ]
      },
      {
        "section": "高潮（宋韵意境与体验）",
        "title": "推近古塔，荷影入梦",
        "content": "14-24秒：沿荷花方向向前推进，逐渐露出古塔，湖面水波与林木光影作细微动态变化；以地面平视远景机位营造岸边眺望感，把荷花、湖面、古塔串成宋韵气息。字幕“荷影塔影，皆是此刻西湖”，仅作氛围文案，不声称古塔年代。",
        "duration_s": 10,
        "place_id": "place_317fc6749411d659",
        "visual_targets": [
