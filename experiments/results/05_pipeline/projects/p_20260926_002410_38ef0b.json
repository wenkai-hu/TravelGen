  "copywriting": {
    "titles": [
      "一湖碧水，宋韵正当时",
      "来西湖，赴一场宋韵之约"
    ],
    "paragraphs": [
      {
        "idx": 1,
        "text": "一湖碧水，铺开千年宋韵。柳丝垂落，世界遗产入画来。",
        "duration_s": 10
      },
      {
        "idx": 2,
        "text": "荷叶连天，粉白初绽。视线越过水面，落向对岸林木与远山。飞檐古塔，塔刹映晴空，一湖留白。",
        "duration_s": 15
      },
      {
        "idx": 3,
        "text": "乘一叶木舟入碧波，桨声轻响。环湖公园免费开放，垂柳步道，随走随停。",
        "duration_s": 12
      },
      {
        "idx": 4,
        "text": "沿湖慢走，木栏伴花影。石塔浮水面，三层亭阁与倒影相对。枝叶框景，宋意尽在含蓄里。",
        "duration_s": 13
      },
      {
        "idx": 5,
        "text": "湖山入画，宋韵正当时。来杭州西湖，乘船漫步打卡，赴一场宋韵之约。",
        "duration_s": 10
      }
    ],
