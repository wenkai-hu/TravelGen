  "planning": {
    "outline": [
      {
        "section": "引入",
        "title": "荷风入画 一眼西湖",
        "content": "以西湖前景大片荷花荷叶为第一视觉，镜头从前景荷花荷叶缓慢后拉或横向平移，露出开阔湖面与湖岸垂柳林木。旁白点题“宋韵杭州，从一池荷风开始”。面向18-35岁年轻游客，突出夏日西湖的清透与大气。保持前景荷花荷叶的层次与虚化关系，不设计清晰特写。",
        "duration_s": 7,
        "place_id": "place_317fc6749411d659",
        "visual_targets": [
          "前景大片荷花荷叶的层次与形态",
          "开阔湖面的横向延伸感",
          "湖岸茂密林木（含垂柳）的景观带"
        ],
        "evidence_asset_ids": [
          "ref_cfc6d53f5d130439"
        ]
      },
      {
        "section": "展开",
        "title": "山水长卷 塔影入湖",
        "content": "镜头沿湖面方向缓慢向前推进或横向平移，展现开阔湖面、沿岸林木、覆满植被的连绵山峦，以及中央偏上位置的多层飞檐古塔与金色塔刹。用“湖山一色、塔影入画”的宋式长卷感承接主题。只呈现档案可见的远景山水塔影，不指认塔名与年代。",
        "duration_s": 8,
        "place_id": "place_317fc6749411d659",
        "visual_targets": [
          "开阔湖面",
          "湖岸茂密林木（含垂柳）",
          "背景覆满植被的连绵山峦轮廓",
          "中央位置的多层飞檐古塔的整体造型与金色塔刹"
        ],
        "evidence_asset_ids": [
          "ref_cfc6d53f5d130439"
        ]
      },
      {
        "section": "高潮",
        "title": "桥上游船 宋韵相逢",
        "content": "远景固定机位或缓慢横移，扫过水面、石拱桥与背景山丘楼阁：石拱桥横跨水面，桥上有行人；棕红色中式游船在水面行驶，船上有乘客；前景虚化荷叶荷花形成画框。旁白带出“人在画中游”的宋韵场景，符合年轻游客偏好的沉浸式打卡想象。不进入桥体、不登塔、不拍桥下仰拍。",
        "duration_s": 9,
        "place_id": "place_317fc6749411d659",
        "visual_targets": [
          "石拱桥的石砌材质、单拱形态与整体结构",
          "水面上的中式游船形态",
          "背景山丘的茂密林木覆盖状态",
          "山顶多层中式塔楼的飞檐翘角、多层结构与红身黑顶的外观特征",
          "前景虚化的绿色荷叶与粉色荷花"
        ],
        "evidence_asset_ids": [
          "ref_0f8857aa518936c4"
        ]
      },
      {
        "section": "收尾",
        "title": "来西湖 把宋韵带进夏天",
        "content": "回到前景观荷视角，从荷花荷叶缓慢拉远至山水桥阁全景，或做固定机位静态长镜头，收束为“杭州西湖，宋韵正当时”的行动召唤。字幕提示：夏季荷开，适合年轻游客来西湖边走边拍。只使用档案支持的远景、横移、后拉镜头，不设计低空穿越荷花丛、环绕古塔等未支持画面。",
        "duration_s": 6,
        "place_id": "place_317fc6749411d659",
        "visual_targets": [
          "前景荷花荷叶的层次布局",
