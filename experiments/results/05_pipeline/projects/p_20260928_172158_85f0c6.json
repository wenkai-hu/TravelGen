  "planning": {
    "outline": [
      {
        "section": "引入",
        "title": "一湖入画，宋韵开场",
        "content": "以西湖荷花前景与开阔湖面横移开场：大片鲜绿荷叶与粉白荷花入画，湖面横向延展，湖岸垂柳与茂密林木轻摇，蓝天白云铺陈夏日晴光。用大气唯美第一眼建立“人在画中游”的宋韵氛围，不涉及无关地点信息。",
        "duration_s": 6,
        "place_id": "place_317fc6749411d659",
        "visual_targets": [
          "前景荷花荷叶",
          "开阔蓝色湖面",
          "湖岸茂密林木含垂柳",
          "蓝天与白色云朵"
        ],
        "evidence_asset_ids": [
          "ref_cfc6d53f5d130439"
        ]
      },
      {
        "section": "展开",
        "title": "远塔近荷，山水成卷",
        "content": "从前景荷花向远景山林间的多层飞檐古塔缓慢推进，保持山峦、林木、湖面、荷花的前后空间层次。古塔只呈现整体轮廓与位置，不做内部、环绕或近距特写；以稳定长镜头带出西湖山水的开阔与宋韵清雅。",
        "duration_s": 8,
        "place_id": "place_317fc6749411d659",
        "visual_targets": [
          "前景荷花荷叶",
          "开阔湖面",
          "湖岸茂密林木",
          "连绵山峦",
          "远景多层飞檐古塔整体轮廓"
        ],
        "evidence_asset_ids": [
          "ref_cfc6d53f5d130439"
        ]
      },
      {
        "section": "高潮",
        "title": "桥影舟行，宋韵流转",
        "content": "镜头缓慢横移或由前景荷花向后方楼阁推近：水面、单孔石拱桥、红色木质游船、桥上行人点缀，与覆满绿植的山丘和山顶多层飞檐中式楼阁形成空间层次。游船可轻微移动，行人可自然增减，突出夏日西湖的园林意境与宋韵审美。",
        "duration_s": 9,
        "place_id": "place_317fc6749411d659",
        "visual_targets": [
          "前景荷花荷叶",
          "蓝色水面",
          "单孔石拱桥",
          "红色木质游船",
          "桥上行人",
          "覆盖茂密绿植的山丘",
          "山顶多层飞檐中式楼阁"
        ],
        "evidence_asset_ids": [
          "ref_0f8857aa518936c4"
        ]
      },
      {
        "section": "收尾",
        "title": "把宋韵留在下一帧",
        "content": "回到开阔湖面与岸林远眺，固定机位或轻微升镜收束，保留湖面横向延伸感、湖岸林木岸线、远景古塔整体轮廓与蓝天白云。以唯美画面承接行动召唤：这个夏天，来杭州西湖，走进宋韵杭州的山水长卷。",
