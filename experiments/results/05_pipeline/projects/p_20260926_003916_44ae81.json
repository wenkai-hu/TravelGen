  "planning": {
    "outline": [
      {
        "section": "视觉吸引",
        "title": "荷风入画",
        "content": "开场以大面积荷花荷叶作为前景，采用从荷花向远处缓慢推进的镜头，让观众的视线沿着荷叶的纹理一路滑向开阔湖面。夏日晴光下，花瓣与叶面透亮，水波轻微起伏，画面只保留荷花、荷叶、湖面与远处隐约的山林轮廓，用最干净的自然层次抓住18-35岁年轻游客的第一眼注意力。不出现古塔名号、年代等信息，只呈现眼前所见之景。",
        "duration_s": 6,
        "place_id": "place_317fc6749411d659",
        "visual_targets": [
          "前景荷花",
          "前景荷叶",
          "中景开阔湖泊"
        ],
        "evidence_asset_ids": [
          "ref_cfc6d53f5d130439"
        ]
      },
      {
        "section": "核心景观",
        "title": "一湖三叠",
        "content": "切换为固定机位远景静帧，完整交代画面的空间秩序：前是荷花荷叶的密植带，中是开阔湖面的形态，对岸是一整条茂密林木的层次，背景是山林与古塔的组合格局。镜头不穿越、不绕行、不进入塔内，只以平视远景呈现这片山水园林式的自然人文景观，天空云朵缓慢流动，让年轻观众直观感受到这座城市地标级的开阔与大气。",
        "duration_s": 6,
        "place_id": "place_317fc6749411d659",
        "visual_targets": [
          "前景荷花荷叶的景观结构",
          "中景开阔湖泊",
          "湖对岸茂密林木带",
          "背景山林与古塔格局",
          "天空云朵"
        ],
        "evidence_asset_ids": [
          "ref_cfc6d53f5d130439"
        ]
      },
      {
        "section": "特色体验",
        "title": "舟行水动",
        "content": "用横向平移镜头掠过湖岸方向，湖面上一两只小型船只缓缓移动，水波随之变化，荷花开放状态与位置有轻微不同，云朵形态也在悄然改变——画面活了，但景观结构保持原样。以荷为前景的慢镜头穿插其中，突出夏日湖上的清凉与闲适，让年轻游客产生“想坐上这条船”的通感体验。",
        "duration_s": 6,
        "place_id": "place_317fc6749411d659",
        "visual_targets": [
          "湖面小型船只",
          "湖面水波动态",
          "湖岸垂柳与阔叶乔木",
          "前景荷花荷叶"
        ],
        "evidence_asset_ids": [
          "ref_cfc6d53f5d130439"
        ]
      },
      {
        "section": "文化特色",
        "title": "塔影入云",
        "content": "视角回到山林与古塔的组合格局，多层飞檐层层收束，塔顶金色塔刹在日光下微微发亮，塔身深色主体与浅色层级结构装饰形成节奏感。镜头只做远景观赏与天空云朵的变化，不近距特写、不绕塔背、不入塔内，也不标注塔的具体名称与建造年代。以塔的轮廓与山林的浓绿共同承载“宋韵杭州”的含蓄气韵，让画面自己说话。",
        "duration_s": 6,
        "place_id": "place_317fc6749411d659",
        "visual_targets": [
          "多层古塔飞檐与金色塔刹",
          "背景山林",
          "天空云朵"
        ],
        "evidence_asset_ids": [
          "ref_cfc6d53f5d130439"
        ]
      },
      {
        "section": "收尾",
        "title": "荷间留白",
        "content": "收尾回到开场的前景荷花，用慢镜头做一次静态凝视：荷叶铺满画面下缘，湖面与林木带在上方层层退远，古塔静静立在山林之中。画面缓慢淡出，字幕收束于“西湖·宋韵杭州”的地域主题与一句简洁的行动召唤，邀请年轻游客在这个夏天亲自来看一眼这片荷与湖。全片不涉及无法确认的地点名称、塔名与年代等具体信息。",
        "duration_s": 6,
        "place_id": "place_317fc6749411d659",
