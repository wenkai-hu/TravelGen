# ===== 密钥与配置（绝不提交！）=====
# 注意：gitignore 不支持行内注释，末尾不能带 # 说明
experiments/config.json
experiments/config.json.*
experiments/config_text.json
experiments/03_video/video_config.json
.env
*.key
*.pem

# ===== Python =====
__pycache__/
*.pyc
.venv/
venv/

# ===== 大文件/素材（用网盘或 Git LFS，见 docs/COLLABORATION.md）=====
*.mp4
*.mkv
*.mov
*.avi
*.zip
*.rar
*.7z
experiments/results/03_video/*.mp4
experiments/results/04_voice/*.wav
experiments/results/04_voice/*.mp3

# assets/ 下只有人工整理的资产入库：BGM 目录 + 预设音色（media_catalog.py 读这两个路径）
# 其余（references/renders/videos/voices/custom）都是跑出来的产物
assets/*
!assets/media/
assets/media/voices/custom/

# 注：experiments/results/ 下的 .md/.csv/.json 文本结果要提交（可复现），仅排除视频音频文件

# ===== 竞赛材料（不随代码库走）=====
# 根目录的说明 PDF 只在本地看；报名材料/ 是提交用的成品（pptx/pdf/演示视频）
/*.pdf
/报名材料/

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 临时 =====
*.tmp
*.log
.test-tools/
test
backend/tests

# ===== 前端 =====
front/node_modules/
front/dist/
front/.npm-cache/
